<dialog id="timer-modal" class="task-modal">
    <div class="auth-card modal-card">
        <button type="button" class="modal-close" aria-label="Close">×</button>
        <h1>Study Timer</h1>

        <div id="timer-setup">
            <label class="modal-label" for="timer-minutes">Minutes</label>
            <div class="input-wrap">
                <input type="number" id="timer-minutes" min="1" max="600" step="1" value="25">
            </div>

            <div class="timer-presets">
                <button type="button" class="timer-preset" data-min="15">15</button>
                <button type="button" class="timer-preset" data-min="25">25</button>
                <button type="button" class="timer-preset" data-min="45">45</button>
                <button type="button" class="timer-preset" data-min="60">60</button>
            </div>

            <button type="button" id="timer-start">Start</button>
        </div>

        <div id="timer-running" hidden>
            <p class="timer-big" id="timer-big">25:00</p>
            <p class="timer-status" id="timer-status"></p>

            <div class="timer-controls">
                <button type="button" id="timer-pause">Pause</button>
                <button type="button" id="timer-reset" class="timer-secondary">Reset</button>
            </div>
        </div>
    </div>
</dialog>

<script>
    (function () {
        const KEY = 'studySproutTimer';
        const modal = document.getElementById('timer-modal');
        const setupView = document.getElementById('timer-setup');
        const runView = document.getElementById('timer-running');
        const big = document.getElementById('timer-big');
        const status = document.getElementById('timer-status');
        const pauseBtn = document.getElementById('timer-pause');
        const minutesInput = document.getElementById('timer-minutes');
        const dashDisplay = document.querySelector('.timer-display');
        const dashDefault = dashDisplay ? dashDisplay.textContent : '25:00';

        let interval = null;
        let timer = load();

        function load() {
            try {
                return JSON.parse(localStorage.getItem(KEY)) || { state: 'idle' };
            } catch (e) {
                return { state: 'idle' };
            }
        }

        function save() {
            try {
                localStorage.setItem(KEY, JSON.stringify(timer));
            } catch (e) {
                // storage unavailable: the timer still works until the page reloads
            }
        }

        function format(sec) {
            const m = Math.floor(sec / 60);
            const s = sec % 60;
            return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
        }

        function secondsLeft() {
            if (timer.state === 'running') {
                return Math.max(0, Math.ceil((timer.endAt - Date.now()) / 1000));
            }
            if (timer.state === 'paused' || timer.state === 'done') {
                return timer.remaining;
            }
            return 0;
        }

        function render() {
            const left = secondsLeft();
            const idle = timer.state === 'idle';

            setupView.hidden = !idle;
            runView.hidden = idle;
            big.textContent = format(left);
            if (dashDisplay) {
                dashDisplay.textContent = idle ? dashDefault : format(left);
            }

            pauseBtn.hidden = timer.state === 'done';
            pauseBtn.textContent = timer.state === 'paused' ? 'Resume' : 'Pause';

            if (timer.state === 'done') {
                status.textContent = "Time's up! Nice work 🌱";
            } else if (timer.state === 'paused') {
                status.textContent = 'Paused';
            } else {
                status.textContent = 'Stay focused!';
            }
        }

        function stopTicking() {
            if (interval) {
                clearInterval(interval);
                interval = null;
            }
        }

        function tick() {
            if (timer.state !== 'running') {
                return;
            }
            if (secondsLeft() <= 0) {
                timer = { state: 'done', remaining: 0 };
                save();
                stopTicking();
            }
            render();
        }

        function startTicking() {
            stopTicking();
            interval = setInterval(tick, 250);
        }

        function start() {
            let minutes = parseInt(minutesInput.value, 10);
            if (!(minutes >= 1)) {
                minutes = 25;
            }
            minutes = Math.min(minutes, 600);
            minutesInput.value = minutes;

            timer = { state: 'running', endAt: Date.now() + minutes * 60 * 1000 };
            save();
            startTicking();
            render();
        }

        function togglePause() {
            if (timer.state === 'running') {
                timer = { state: 'paused', remaining: secondsLeft() };
                stopTicking();
            } else if (timer.state === 'paused') {
                timer = { state: 'running', endAt: Date.now() + timer.remaining * 1000 };
                startTicking();
            }
            save();
            render();
        }

        function reset() {
            timer = { state: 'idle' };
            save();
            stopTicking();
            render();
        }

        document.querySelectorAll('.open-timer').forEach((el) => {
            el.addEventListener('click', (e) => {
                e.preventDefault();
                render();
                modal.showModal();
            });
        });

        document.querySelectorAll('.timer-preset').forEach((btn) => {
            btn.addEventListener('click', () => {
                minutesInput.value = btn.dataset.min;
            });
        });

        function quickStart() {
            if (timer.state === 'idle' || timer.state === 'done') {
                minutesInput.value = 60;
                start();
            } else {
                render();
            }
            modal.showModal();
        }

        document.querySelectorAll('.quick-timer').forEach((el) => {
            el.addEventListener('click', quickStart);
            el.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    quickStart();
                }
            });
        });

        minutesInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                start();
            }
        });

        document.getElementById('timer-start').addEventListener('click', start);
        pauseBtn.addEventListener('click', togglePause);
        document.getElementById('timer-reset').addEventListener('click', reset);

        modal.querySelector('.modal-close').addEventListener('click', () => modal.close());
        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                modal.close();
            }
        });

        if (timer.state === 'running') {
            startTicking();
        }
        render();
    })();
</script>