<div class="dashboard-page">
<main class="dashboard">

        <h1>Welcome Back &#x1F62E;&#x200D;&#x1F4A8;</h1>

        <section class="card">
            <h2>Today's Progress</h2>
            <progress value="75" max="100"></progress>
            <span>75%</span>
        </section>

        <section class="card">
            <h2>Upcoming Tasks</h2>

            <ul>
                <li><label><input type="checkbox">Task 1</label></li>
                <li><label><input type="checkbox">Task 2</label></li>
                <li><label><input type="checkbox">Task 3</label></li>
            </ul>
        </section>

        <section class="card">
            <h2>Study Timer</h2>

            <p class="time">30:00</p>
            <button>Start</button>
        </section>

        <section class="card">
            <h2>&#127942; Leaderboard</h2>

            <ol>
                <li>Name #1 <span class="score">0</span></li>
                <li class="you">You <span class="score">0</span></li>
                <li>Name #2 <span class="score">0</span></li>
            </ol>
        </section>
    </main>
</div>