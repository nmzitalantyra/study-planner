{{> header-user}}

<main>

    <!-- HERO SECTION -->
    <section class="hero hero-home">

        <div class="hero-content">

            <p class="eyebrow">🌱 WELCOME BACK</p>

            <h1>Grow Your<br>Productivity.</h1>

            <h2>Your studies, organized one step at a time.</h2>

            <p class="hero-description">
                Welcome back, {{username}}! Organize assignments,
                track deadlines, and stay motivated with friends.
            </p>

        </div>


        <!-- DASHBOARD PREVIEW -->
        <div class="dashboard-preview dashboard-wide">

            <h2><a href="/leaderboard">My Study Dashboard 🌱</a></h2>

            <div class="progress-section">
                <p>This Week's Progress</p>

                <div class="progress-bar">
                    <div class="progress-fill" style="width: {{percent}}%"></div>
                </div>

                <span>{{done}} of {{total}} completed · {{percent}}%</span>
            </div>


            <div class="preview-tasks">

                <h3>Upcoming Tasks</h3>

                {{#each assignments}}
                    <div class="task {{#if completed}}task-done{{/if}}">
                        <form action="/assignments/{{id}}/toggle" method="post" class="task-check-form">
                            <button type="submit" class="task-check" aria-label="Toggle complete">{{#if completed}}✓{{else}}○{{/if}}</button>
                        </form>
                        <div>
                            <strong>{{title}}</strong>
                            <small>{{course}} · Due {{due_label}}</small>
                        </div>
                        <button type="button" class="task-edit" aria-label="Edit"
                            data-id="{{id}}" data-title="{{title}}" data-course="{{course}}" data-due="{{due_iso}}">✎</button>
                    </div>
                {{else}}
                    <p class="empty-tasks">No assignments yet. Click Task Manager below to add one.</p>
                {{/each}}

            </div>


            <div class="timer-preview">
                <h3>Study Timer ⏱️</h3>
                <p class="timer-display">25:00</p>
                <span>Focus on your goals!</span>
            </div>


            <div class="leaderboard-preview">
                <h3>Study Buddies 🏆</h3>

                <p>🥇 Alex <span>12 hrs</span></p>
                <p>🥈 Jamie <span>10 hrs</span></p>
                <p>🥉 Taylor <span>8 hrs</span></p>
            </div>

        </div>

    </section>


    <!-- FEATURES SECTION -->
    <section class="features">

        <h2>What You Can Grow</h2>

        <p class="section-description">
            Everything you need to make studying a little easier.
        </p>

        <div class="feature-grid">

            <a href="#" class="feature-card" id="open-task-modal">
                <span class="feature-icon">📝</span>
                <h3>Task Manager</h3>
                <p>
                    Create tasks, organize assignments,
                    and keep track of deadlines.
                </p>
            </a>

            <div class="feature-card">
                <span class="feature-icon">📊</span>
                <h3>Study Dashboard</h3>
                <p>
                    Keep your academic responsibilities
                    and progress organized in one place.
                </p>
            </div>

            <div class="feature-card">
                <span class="feature-icon">⏱️</span>
                <h3>Study Timer</h3>
                <p>
                    Stay focused and manage your
                    study sessions effectively.
                </p>
            </div>

            <div class="feature-card">
                <span class="feature-icon">🏆</span>
                <h3>Friendly Competition</h3>
                <p>
                    Compete with friends and motivate
                    each other to reach your goals.
                </p>
            </div>

        </div>

    </section>


    <!-- MOTIVATIONAL SECTION -->
    <section class="motivation">

        <h2>Small Steps. Big Growth. 🌱</h2>

        <p>
            Every study session helps you grow.
            Keep building better study habits today!
        </p>

    </section>

</main>

{{> tasks}}
{{> edit_tasks}}

{{> footer}}