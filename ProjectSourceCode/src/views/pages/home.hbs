
{{> header}}

<main>

    <!-- HERO SECTION -->
    <section class="hero">

        <div class="hero-content">

            <p class="eyebrow">🌱 READY TO GROW?</p>

            <h1>Grow Your<br>Productivity.</h1>

            <h2>Your studies, organized one step at a time.</h2>

            <p class="hero-description">
                Turn your study goals into accomplishments,
                one task at a time. Organize assignments,
                track deadlines, and stay motivated with friends.
            </p>

            <a href="/register" class="primary-button">
                Get Started
            </a>

            <p class="login-prompt">
                Already have an account?
                <a href="/login">Log in</a>
            </p>

        </div>


        <!-- DASHBOARD PREVIEW -->
        <div class="dashboard-preview">

            <h2>My Study Dashboard 🌱</h2>

            <div class="progress-section">
                <p>Today's Progress</p>

                <div class="progress-bar">
                    <div class="progress-fill"></div>
                </div>

                <span>70% Completed</span>
            </div>


            <div class="preview-tasks">

                <h3>Upcoming Tasks</h3>

                <div class="task">
                    <span>○</span>
                    <div>
                        <strong>Biology Assignment</strong>
                        <small>Due Today</small>
                    </div>
                </div>

                <div class="task">
                    <span>○</span>
                    <div>
                        <strong>Chemistry Quiz</strong>
                        <small>Due Tomorrow</small>
                    </div>
                </div>

                <div class="task">
                    <span>✓</span>
                    <div>
                        <strong>CS Project</strong>
                        <small>Completed</small>
                    </div>
                </div>

            </div>


            <div class="timer-preview">
                <h3>Study Timer ⏱️</h3>
                <p class="timer-display">25:00</p>
                <span>Focus on your goals!</span>
            </div>


            <div class="leaderboard-preview">
                <h3>Study Buddies 🏆</h3>

                <p>🥇 Alex <span>12 hrs</span></p>
                <p>🥈 Jamie <span>10 hrs</span></p>
                <p>🥉 Taylor <span>8 hrs</span></p>
            </div>

        </div>

    </section>


    <!-- FEATURES SECTION -->
    <section class="features">

        <h2>What You Can Grow</h2>

        <p class="section-description">
            Everything you need to make studying a little easier.
        </p>

        <div class="feature-grid">

            <div class="feature-card">
                <span class="feature-icon">📝</span>
                <h3>Task Manager</h3>
                <p>
                    Create tasks, organize assignments,
                    and keep track of deadlines.
                </p>
            </div>

            <div class="feature-card">
                <span class="feature-icon">📊</span>
                <h3>Study Dashboard</h3>
                <p>
                    Keep your academic responsibilities
                    and progress organized in one place.
                </p>
            </div>

            <div class="feature-card">
                <span class="feature-icon">⏱️</span>
                <h3>Study Timer</h3>
                <p>
                    Stay focused and manage your
                    study sessions effectively.
                </p>
            </div>

            <div class="feature-card">
                <span class="feature-icon">🏆</span>
                <h3>Friendly Competition</h3>
                <p>
                    Compete with friends and motivate
                    each other to reach your goals.
                </p>
            </div>

        </div>

    </section>


    <!-- MOTIVATIONAL SECTION -->
    <section class="motivation">

        <h2>Small Steps. Big Growth. 🌱</h2>

        <p>
            Every study session helps you grow.
            Start building better study habits today!
        </p>

        <a href="/register" class="primary-button">
            Start Growing
        </a>

    </section>

</main>

{{> footer}}
